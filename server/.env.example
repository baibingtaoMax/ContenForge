# 服务端口（前端 vite 代理指向 3200，改端口需同步改 client/vite.config.ts）
PORT=3200
NODE_ENV=development

# 火山引擎方舟（OpenAI 兼容网关）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_API_KEY=your-api-key-here

# 对话模型
ARK_MODEL=doubao-seed-2.0-pro
# 向量模型（项目记忆检索用，维度变更需在「模型配置」里清空旧向量重建）
ARK_EMBEDDING_MODEL=doubao-embedding-vision
# 视觉模型（截图转需求等图片理解用，留空则回退到 ARK_MODEL）
ARK_MODEL_VISION=
